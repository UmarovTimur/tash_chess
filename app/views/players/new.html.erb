<% content_for :title, t(".title") %>

<div class="narrow">
  <h1><%= t(".title") %></h1>
  <% if @tournament %>
    <p class="muted"><%= t(".joins_tournament_html", tournament: @tournament.name) %></p>
  <% end %>
  <div class="card"><%= render "form", player: @player, tournament: @tournament %></div>
</div>

<%= form_with model: player, class: "form" do |form| %>
  <%= render "shared/errors", record: player %>
  <%= hidden_field_tag :tournament_id, tournament.id if tournament %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true, maxlength: 100, autofocus: true, autocomplete: "off" %>
  </div>

  <div class="field">
    <%= form.label :nickname %>
    <%= form.text_field :nickname, required: true, maxlength: 30, autocomplete: "off" %>
    <p class="hint"><%= t(".nickname_hint") %></p>
  </div>

  <div class="field">
    <%= form.label :fide_rating %>
    <%= form.number_field :fide_rating, min: 1000, max: 3000, step: 1, inputmode: "numeric" %>
    <p class="hint"><%= t(".rating_hint") %></p>
  </div>

  <div class="form__actions">
    <%= form.submit class: "btn btn--primary" %>
    <%= link_to t("shared.cancel"), tournament || (player.persisted? ? player : players_path), class: "btn btn--ghost" %>
  </div>
<% end %>

<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= [ content_for(:title), "Tash Chess" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Tash Chess">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refresh_method_tag :morph %>
    <%= turbo_refresh_scroll_tag :preserve %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="container topbar__inner">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand__mark" aria-hidden="true">♞</span> Tash Chess
        <% end %>
        <div class="topbar__end">
          <nav class="nav">
            <%= nav_link_to t(".tournaments"), tournaments_path, active: controller_path.start_with?("tournaments") || controller_name == "games" %>
            <%= nav_link_to t(".players"), players_path, active: controller_name == "players" %>
          </nav>
          <div class="locale-switch" role="group" aria-label="<%= t(".language") %>">
            <% I18n.available_locales.each do |locale| %>
              <%= button_to locale.to_s.upcase, locale_path, method: :patch, params: { locale: },
                    class: class_names("locale-switch__button", "locale-switch__button--active": locale == I18n.locale),
                    form_class: "locale-switch__form", lang: locale, title: t("locales.#{locale}"),
                    aria: { pressed: locale == I18n.locale } %>
            <% end %>
          </div>
        </div>
      </div>
    </header>

    <main class="container main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>

<% content_for :title, "Standings · #{@tournament.name}" %>
<%= render "tournaments/header", tournament: @tournament, tab: :standings %>

<section class="card card--flush" aria-labelledby="standings-title">
  <div class="card__head">
    <h2 id="standings-title"><%= @tournament.finished? ? "Final standings" : "Current standings" %></h2>
    <% if @tournament.in_progress? %>
      <span class="live" title="Updates by itself when a result is entered"><span class="live__dot"></span> Live</span>
    <% end %>
  </div>

  <% if @standings.rows.any? %>
    <div class="table-scroll">
      <table class="table table--standings">
        <thead>
          <tr>
            <th class="num">#</th>
            <th>Player</th>
            <th class="num">FIDE</th>
            <% 1.upto(@standings.rounds_count) do |number| %>
              <th class="round-cell" title="Round <%= number %>">R<%= number %></th>
            <% end %>
            <th class="num points-col">Points</th>
            <% if @tournament.swiss? %><th class="num" title="Buchholz: sum of opponents' points">Buch.</th><% end %>
            <th class="num" title="Sonneborn-Berger: points of beaten opponents plus half the points of drawn ones">S-B</th>
            <th class="num" title="Wins / draws / losses">W / D / L</th>
          </tr>
        </thead>
        <tbody>
          <% @standings.each do |row| %>
            <tr class="<%= class_names("standing", "standing--podium": @tournament.finished? && row.rank <= 3) %>">
              <td class="num rank"><%= row.rank %></td>
              <td><%= link_to row.player.name, row.player, class: "strong-link" %> <span class="nick">@<%= row.player.nickname %></span></td>
              <td class="num"><%= rating(row.player) %></td>
              <% row.cells.each do |cell| %>
                <td class="round-cell"><%= standings_cell(cell) %></td>
              <% end %>
              <td class="num points-col"><strong><%= format_score(row.points) %></strong></td>
              <% if @tournament.swiss? %><td class="num"><%= format_score(row.buchholz) %></td><% end %>
              <td class="num"><%= format_tiebreak(row.sonneborn_berger) %></td>
              <td class="num muted"><%= row.wins %> / <%= row.draws %> / <%= row.losses %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty empty--inset">No members yet.</div>
  <% end %>
</section>

<p class="hint legend">
  Ties are broken by <%= @tournament.swiss? ? "Buchholz, then Sonneborn-Berger, then wins" : "Sonneborn-Berger, then wins" %>.
  In round cells: <%= piece_color(:white) %> / <%= piece_color(:black) %> color played, “+” bye, “–” rested, “…” in play.
</p>
